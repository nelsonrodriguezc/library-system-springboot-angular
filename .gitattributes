# Normalise line endings so the repository behaves the same on Windows and Linux.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts run inside Linux containers: LF is mandatory.
mvnw text eol=lf
*.sh text eol=lf

# Binary assets must never be normalised.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
