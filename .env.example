# Copy this file to .env before running `docker compose up`.
# .env is git-ignored on purpose: no credentials or secrets belong in the repository.

# --- Database --------------------------------------------------------------
POSTGRES_DB=libris
POSTGRES_USER=libris
POSTGRES_PASSWORD=change-me-locally

# --- Security --------------------------------------------------------------
# HS256 signing key for JWT. Must be at least 32 characters long.
# Leave it empty to let the application generate an ephemeral key at startup
# (it logs a WARN and every restart invalidates previously issued tokens).
# Generate a real one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# --- Mail (MailHog in local development) -----------------------------------
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=biblioteca@libris.local

# --- Business rules --------------------------------------------------------
LIBRIS_LOAN_DAYS=14
LIBRIS_MAX_ACTIVE_LOANS=3
LIBRIS_REMINDER_DAYS_BEFORE=2
LIBRIS_OVERDUE_LIMIT=3
LIBRIS_OVERDUE_WINDOW_DAYS=90
LIBRIS_BLOCK_DAYS=7

# --- Open Library ----------------------------------------------------------
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_COVERS_URL=https://covers.openlibrary.org
OPEN_LIBRARY_TIMEOUT_SECONDS=3
# Open Library throttles clients that do not identify themselves.
OPEN_LIBRARY_USER_AGENT=Libris/1.0 (library loan management technical test)
